# 基金管理系统 - 环境变量配置
# 复制此文件为 .env 并修改配置

# ============================================
# Docker 部署配置
# ============================================

# 数据目录挂载路径（Docker 部署时使用）
# 默认: ./data (项目目录下的 data 文件夹)
# 生产环境示例: /home/user/fund_data
DATA_PATH=./data

# ============================================
# 安全相关（legacy，保留兼容）
# ============================================

# JWT 密钥 - 生产环境务必修改！
# 生成命令: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production

# ============================================
# 数据库配置
# ============================================

# SQLite 数据库路径
# 默认保存在项目目录的 data/ 文件夹下
DATABASE_URL=sqlite:///./data/fund_manager.db

# ============================================
# 认证配置（legacy，保留兼容）
# ============================================

# JWT Token 有效期（天）
ACCESS_TOKEN_EXPIRE_DAYS=7

# JWT 算法
ALGORITHM=HS256

# 默认管理员密码（首次初始化数据库时创建 admin 账号使用）
# 未设置时系统会随机生成一个密码并打印在日志中
DEFAULT_ADMIN_PASSWORD=your-admin-password

# ============================================
# 统一认证中台 auth-service 配置
# ============================================

# auth-service 容器内部访问地址（后端 token 交换 / JWKS 用）
AUTH_SERVICE_URL=http://host.docker.internal:20263

# auth-service 公网地址（浏览器跳转用）
AUTH_SERVICE_PUBLIC_URL=http://localhost:20263

# JWKS 端点（后端容器内部访问）
AUTH_SERVICE_JWKS_URL=http://host.docker.internal:20263/.well-known/jwks.json

# JWT issuer，必须与 auth-service 签发的 token 的 iss 一致
AUTH_SERVICE_ISSUER=http://localhost:20263

# 当前应用在 auth-service 注册的 client_id
AUTH_CLIENT_ID=vestoria

# 当前应用在 auth-service 注册的 client_secret（本地开发对应 auth-service .env 中的 VESTORIA_CLIENT_SECRET）
AUTH_CLIENT_SECRET=local-vestoria-secret

# 前端公网地址（OAuth redirect_uri 用）
FRONTEND_URL=http://localhost:20260

# BFF 服务端会话。生产环境 FRONTEND_URL 含 /fund 时会自动使用 /fund/ cookie Path。
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_PATH=
SESSION_COOKIE_SECURE=false

# ============================================
# 测试配置
# ============================================

# 测试脚本使用的管理员账号（仅本地测试使用）
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=your-test-password
